<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>ToDo（Microfrontend）</masterLabel>
    <description>Vercel にある React の ToDo リストを lightning-ui-embedding で表示するホスト LWC。</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <property name="appUrl" type="String" label="アプリの URL" default="https://todo-list-eta-puce-62.vercel.app/embed/" />
            <property name="cardTitle" type="String" label="カードのタイトル" default="ToDo（Microfrontend）" />
            <objects>
                <object>Opportunity</object>
            </objects>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
